@baseUrl = http://localhost:8081

### 1. Создать первого пользователя — Иванова

POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "lastName": "Иванов",
  "firstName": "Иван",
  "middleName": "Иванович",
  "email": "ivanov-{{$uuid}}@mail.ru"
}

> {%
    client.global.set("user1", response.body.id);
%}


### 2. Создать второго пользователя — Карпова

POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "lastName": "Карпов",
  "firstName": "Кирилл",
  "middleName": null,
  "email": "karpov-{{$uuid}}@mail.ru"
}

> {%
    client.global.set("user2", response.body.id);
%}


### 3. Подать первую заявку (два автора)

POST {{baseUrl}}/api/applications
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="data"
Content-Type: application/json

{
  "title": "Разработка математической модели насоса",
  "directionId": 2,
  "submitterUserId": {{user1}},
  "authors": [
    {"userId": {{user1}}},
    {"userId": {{user2}}}
  ]
}
--boundary
Content-Disposition: form-data; name="file"; filename="thesis.docx"
Content-Type: application/octet-stream

Тестовое содержимое файла первой заявки.
--boundary--

> {%
    client.global.set("application1", response.body.id);
%}


### 4. Получить список заявок

GET {{baseUrl}}/api/applications


### 5. Скачать файл первой заявки

GET {{baseUrl}}/api/applications/{{application1}}/file


### 6. Отозвать первую заявку

POST {{baseUrl}}/api/applications/{{application1}}/withdraw


### 7. Повторно отозвать первую заявку (ожидаем 409)

POST {{baseUrl}}/api/applications/{{application1}}/withdraw


### 8. Подать вторую заявку

POST {{baseUrl}}/api/applications
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="data"
Content-Type: application/json

{
  "title": "Вторая заявка",
  "directionId": 2,
  "submitterUserId": {{user1}},
  "authors": [
    {"userId": {{user1}}}
  ]
}
--boundary
Content-Disposition: form-data; name="file"; filename="second-thesis.docx"
Content-Type: application/octet-stream

Тестовое содержимое файла второй заявки.
--boundary--

> {%
    client.global.set("application2", response.body.id);
%}


### 9. Изменить вторую заявку

PUT {{baseUrl}}/api/applications/{{application2}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="data"
Content-Type: application/json

{
  "title": "Новое название работы",
  "directionId": 7,
  "submitterUserId": {{user1}},
  "authors": [
    {"userId": {{user1}}}
  ]
}
--boundary--